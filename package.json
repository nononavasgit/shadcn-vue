{
  "name": "@nononavas/shadcn-vue",
  "version": "0.2.0",
  "description": "Librería personal de componentes Vue con Reka UI y Tailwind CSS",
  "keywords": [
    "shadcn-vue",
    "vue"
  ],
  "homepage": "https://github.com/nononavasgit/shadcn-vue#readme",
  "bugs": {
    "url": "https://github.com/nononavasgit/shadcn-vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nononavasgit/shadcn-vue.git"
  },
  "license": "ISC",
  "author": "José Antonio Navas",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./components/ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "import": "./dist/components/ui/*/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./assets/icons": {
      "types": "./dist/assets/icons/index.d.ts",
      "import": "./dist/assets/icons/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "doc": "docs"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "src/components/app"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "cli": "node ./bin/shadcn-vue.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.39",
    "vue-tsc": "^3.2.5"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "module": "./dist/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "shadcn-vue": "./bin/shadcn-vue.mjs"
  }
}
